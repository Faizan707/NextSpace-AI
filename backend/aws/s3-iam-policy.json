{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NextSpaceListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::nextspace-ai"
    },
    {
      "Sid": "NextSpaceObjectReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::nextspace-ai/*"
    }
  ]
}
