# Fast local development:
DATABASE_URL=sqlite:///./nextspace_local.db

# Or remote Neon / Postgres (use this on Railway):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_NAME=NextSpace AI

# Invite links + CORS target.
# Local: http://127.0.0.1:5174
# Production: https://next-space-ai.vercel.app
FRONTEND_URL=https://next-space-ai.vercel.app

# Extra browser origins (comma-separated). FRONTEND_URL is always included.
CORS_ORIGINS=https://next-space-ai.vercel.app,http://127.0.0.1:5174,http://localhost:5174
# Invite emails (optional). Without these, invites still work and the link is shown in admin UI.
# Example Gmail app password:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=NextSpace <you@gmail.com>
# SMTP_USE_TLS=true
# On Railway, if 587 times out use: SMTP_PORT=465 + SMTP_USE_SSL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Railway: set SMTP_PREFER_API=true and BREVO_API_KEY=xkeysib-... (SMTP ports often time out)
SMTP_PREFER_API=true
BREVO_API_KEY=

# AWS S3 uploads (optional). Without these, files stay in backend/uploads/.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=nextspace-ai

# AI (local Ollama now; switch to openai later)
AI_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=nextspace_docs
# AI_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
